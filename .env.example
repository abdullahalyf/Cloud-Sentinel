# Copy this file to `.env` and fill in values.  NEVER commit `.env` (it's in .gitignore).

# ── The brain: which LLM judges suspicious agents: claude | gemini (no key → fallback rules) ──
BRAIN_PROVIDER=claude

# ── Claude (only Alif/Taseen need a key; without it the brain uses fallback rules) ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# a slow Claude answer falls back to rules after this many seconds (the loop never waits for it)
CLAUDE_TIMEOUT_SECONDS=10
# USD per 1M tokens — used for "Sentinel spent $X to save $Y" (update if you change CLAUDE_MODEL)
CLAUDE_PRICE_IN_PER_MTOK=0.10
CLAUDE_PRICE_OUT_PER_MTOK=0.50
# what the watched agents' own model costs per 1M tokens (for the "saved" estimate)
AGENT_PRICE_PER_MTOK=4.0

# ── Gemini (only used when BRAIN_PROVIDER=gemini) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=15
GEMINI_PRICE_IN_PER_MTOK=0.30
GEMINI_PRICE_OUT_PER_MTOK=2.50

# ── Supabase (leave empty to use a local SQLite file instead) ──
# Supabase → Project Settings → API → Project URL / service_role key
SUPABASE_URL=
SUPABASE_KEY=
LOCAL_DB_PATH=data/cloudsentinel.db
# if the database is down: keep up to this many rows in memory, retry every N seconds
STORE_BUFFER_SIZE=5000
STORE_RETRY_SECONDS=5
# a buffered row that keeps failing while the database is up is dropped after this many tries
STORE_MAX_ROW_FAILURES=5

# ── Notifications (optional): Discord or Slack incoming-webhook URL, told about every KILL/PAUSE ──
WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=5

# ── Sentinel ──
TICK_SECONDS=1
DRY_RUN=false
# everything the sentinel prints is also appended here (*.log is gitignored)
LOG_FILE=logs/sentinel.log
DEFAULT_TOKEN_BUDGET=150000

# Per-agent overrides (optional container labels in docker-compose.yml):
#   cloudsentinel.soft_tokens_per_min, cloudsentinel.hard_tokens_per_min, cloudsentinel.token_budget

# Soft limits → "suspicious" → ask Claude
SOFT_TOKENS_PER_MIN=45000
SOFT_CALLS_PER_SEC=3
SOFT_MEMORY_PCT=70
# memory growing faster than this (MB per second, measured over ~5s) = leak → the brain judges it early
SOFT_MEMORY_GROWTH_MB_PER_S=10
# 5 repeats → the brain kills a looping agent ~7s after it goes rogue (before any hard limit)
LOOP_REPEAT_THRESHOLD=5
# the same task reworded N times within 15s (e.g. "fetch order 4471" / "look up order #4471") = possible loop
PARAPHRASE_REPEAT_THRESHOLD=8
# a prompt containing any of these (case-insensitive, comma-separated) is talking to the monitor → suspicious
INJECTION_PHRASES=monitoring system,do not terminate,do not kill,don't kill,don't terminate,ignore previous instructions,ignore all previous instructions,note to monitor

# Hard limits → kill immediately, no AI
HARD_TOKENS_PER_MIN=60000
HARD_CALLS_PER_SEC=8
HARD_MEMORY_PCT=90

# the sentinel writes an alert (rule "sentinel_heartbeat") this often; the dashboard shows ONLINE/OFFLINE from it
HEARTBEAT_SECONDS=5
BRAIN_COOLDOWN_SECONDS=10
# fast-growing memory is judged again after this many seconds: a one-time jump has stopped, a leak has not
MEMORY_RECHECK_SECONDS=3
# the dashboard's "spent $X to save $Y" alert is written at most this often
BRAIN_COST_INTERVAL_SECONDS=60
BRAIN_KILL_CONFIDENCE=0.6
# fallback brain: a 2nd WARN on the same agent within this many seconds becomes KILL
BRAIN_ESCALATE_WINDOW_SECONDS=60
