# Copy to `.env` and fill in. NEVER commit `.env` (it's in .gitignore). All names: docs/CONTRACTS.md §3.

# ── Judge (no key → deterministic fallback judge, still works offline) ──
ANTHROPIC_API_KEY=
JUDGE_PROVIDER=auto              # auto | claude | gemini | fallback
CLAUDE_MODEL=claude-haiku-5-5
GEMINI_API_KEY=                  # optional (pip install google-genai)
GEMINI_MODEL=gemini-2.5-flash

# ── Store (leave Supabase empty → local SQLite file) ──
SUPABASE_URL=
SUPABASE_KEY=
LOCAL_DB_PATH=data/cloudsentinel.db

# ── API / SDK / collector ──
CS_API_URL=http://localhost:8000
CS_API_TOKEN=                    # set to require header X-CS-Token on the C2 API
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
CS_CAPTURE_PROMPTS=true          # synthetic data only!

# ── Runtime ──
EXECUTOR=docker                  # docker | k8s   (python -m brain --fake ignores this)
TICK_SECONDS=1
DRY_RUN=false
DEFAULT_BUDGET_USD=0.50

# ── Rules ── soft → ask the judge · hard → trip immediately (works even if the judge is down)
SOFT_TOKENS_PER_MIN=25000
HARD_TOKENS_PER_MIN=60000
SOFT_CALLS_PER_SEC=2
HARD_CALLS_PER_SEC=8
SOFT_MEMORY_PCT=70
HARD_MEMORY_PCT=90
LOOP_REPEAT_THRESHOLD=8
LOOP_SCORE_THRESHOLD=0.6

BRAIN_COOLDOWN_SECONDS=10
BRAIN_KILL_CONFIDENCE=0.6
PROBATION_SECONDS=30
TOOL_APPROVAL_TIMEOUT_SECONDS=120
ROI_HORIZON_MINUTES=60

# ── Auto-heal (the judge proposes a patch; a confident one is applied, the rest waits for a human) ──
CS_AUTOHEAL=true
CS_AUTOHEAL_MIN_CONFIDENCE=0.85

# ── Adaptive baselines (each agent learns its own limits from healthy behaviour) ──
CS_BASELINE_ENABLED=true
CS_BASELINE_WARMUP_SECONDS=60    # seconds on the fixed soft limits before the agent's own baseline is used
CS_BASELINE_K=4                  # limit = median + K × 1.4826 × MAD

# ── Policy hot reload (edit brain/policies.yaml and the brain picks it up — no restart) ──
CS_POLICY_RELOAD_ENABLED=true    # false → the policy file is read once at startup and never again
CS_POLICY_RELOAD_INTERVAL_SECONDS=1   # how often the policy file's mtime is checked

# ── MCP server (lets Claude Desktop / Claude Code drive the fleet) ──
CS_MCP_READONLY=false                # true → expose only the tools that change nothing
CS_MCP_RATE_LIMIT=30                 # destructive calls per minute, per session (reads are never throttled)
CS_MCP_HTTP_HOST=127.0.0.1           # a non-localhost bind needs CS_API_TOKEN, or the server refuses to start
CS_MCP_HTTP_PORT=8765

# ── Brain sharding (N brain worker processes share the fleet) ──
CS_WORKER_ID=                      # this worker's id; empty → one generated from the pid
CS_WORKER_HEARTBEAT_SECONDS=2      # how often a worker says "I am alive"
CS_WORKER_STALE_SECONDS=10         # a worker that has not beaten for this long is dead

# ── Optional: copy every span to Arize Phoenix (the collector forwards, agents don't change) ──
CS_EXPORT_PHOENIX=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006   # Phoenix OTLP/HTTP base URL (…/v1/traces is added)
PHOENIX_API_KEY=                                   # only for Phoenix Cloud / auth-enabled Phoenix
PHOENIX_PROJECT_NAME=cloudsentinel
CS_EXPORT_CLOUDWATCH=false                        # also write CloudWatch EMF JSON lines (collector)
CS_CLOUDWATCH_FILE=data/cloudwatch.jsonl
